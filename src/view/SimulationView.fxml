<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.scene.chart.*?>
<fx:root type="javafx.scene.layout.BorderPane" xmlns:fx="http://javafx.com/fxml/1">
 <top><VBox spacing="10">
  <Label text="Strategy lab · ¿y si hubieras parado antes?" styleClass="section-title"/>
  <FlowPane hgap="8" vgap="8"><ComboBox fx:id="driver" prefWidth="220"/><ComboBox fx:id="initial" prefWidth="110"/><Label text="Edad inicial"/><Spinner fx:id="age" prefWidth="85"/><Label text="Paradas vuelta:compuesto[:edad]"/><TextField fx:id="stops" prefWidth="230"/><Button fx:id="calculate" text="Comparar escenarios" styleClass="danger-button"/></FlowPane>
  <Label fx:id="historicalLabel" wrapText="true" styleClass="coverage-label"/>
  <FlowPane hgap="8" vgap="8">
   <VBox><Label text="Degradación estimada s/v" styleClass="stat-caption"/><TextField fx:id="degradation" prefWidth="105"/></VBox>
   <VBox><Label text="Pérdida neta pits s" styleClass="stat-caption"/><TextField fx:id="pitLoss" prefWidth="105"/></VBox>
   <VBox><Label text="Combustible estimado s/v" styleClass="stat-caption"/><TextField fx:id="fuel" prefWidth="105"/></VBox>
   <VBox><Label text="Calentamiento s" styleClass="stat-caption"/><TextField fx:id="warmup" prefWidth="95"/></VBox>
   <VBox><Label text="Efecto SOFT s" styleClass="stat-caption"/><TextField fx:id="softEffect" prefWidth="85"/></VBox>
   <VBox><Label text="Efecto MEDIUM s" styleClass="stat-caption"/><TextField fx:id="mediumEffect" prefWidth="85"/></VBox>
   <VBox><Label text="Efecto HARD s" styleClass="stat-caption"/><TextField fx:id="hardEffect" prefWidth="85"/></VBox>
  </FlowPane>
  <Label fx:id="evidence" wrapText="true" styleClass="muted"/>
 </VBox></top>
 <center><LineChart fx:id="deltaChart" title="Diferencia acumulada entre escenarios estimados"><xAxis><NumberAxis label="Vuelta" forceZeroInRange="false"/></xAxis><yAxis><NumberAxis label="Δ segundos (alternativa − histórica modelada)"/></yAxis></LineChart></center>
 <bottom><VBox spacing="8"><Label fx:id="resultLabel" wrapText="true" styleClass="explanation-card"/><Label fx:id="limitations" wrapText="true" styleClass="muted"/></VBox></bottom>
</fx:root>
