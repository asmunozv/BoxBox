<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.scene.chart.*?>
<fx:root type="javafx.scene.layout.BorderPane" xmlns:fx="http://javafx.com/fxml/1">
 <top><VBox spacing="10"><Label text="Posiciones · sigue a tus pilotos" styleClass="section-title"/><Label text="Marca pilotos para comparar sus líneas. Pulsa un punto: verás posición, vuelta y si hubo un paso por pits. P1 está arriba." wrapText="true" styleClass="muted"/><FlowPane fx:id="driverChoices" hgap="12" vgap="8"/></VBox></top>
 <center><LineChart fx:id="positions" title="Evolución de posiciones · P1 arriba" createSymbols="true" prefHeight="360" minHeight="360"><xAxis><NumberAxis label="Vuelta" forceZeroInRange="false" tickUnit="5"/></xAxis><yAxis><NumberAxis fx:id="positionAxis" label="Posición"/></yAxis></LineChart></center>
 <bottom><Label fx:id="pointDetail" wrapText="true" styleClass="explanation-card"/></bottom>
</fx:root>
