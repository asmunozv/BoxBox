<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.BorderPane" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <VBox spacing="10">
            <Label text="Races &amp; Circuits Management" styleClass="section-title" />
            <Label text="Click a red point on the world map to open circuit details." />
            <StackPane fx:id="mapContainer" prefHeight="560.0" style="-fx-background-color: linear-gradient(to bottom right, #ffffff, #eaf2ff); -fx-background-radius: 10; -fx-border-color: #cfd8e6; -fx-border-radius: 10;">
                <ImageView fx:id="mapImageView" preserveRatio="true" fitWidth="1000.0" smooth="true" />
                <Pane fx:id="mapOverlayPane" pickOnBounds="false" />
            </StackPane>
            <HBox spacing="8">
                <Button text="Refresh" onAction="#onRefresh" />
            </HBox>
            <padding>
                <Insets />
            </padding>
        </VBox>
    </center>
</fx:root>
