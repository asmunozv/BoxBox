<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.BorderPane" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <VBox spacing="10">
            <Label text="Circuits Management" styleClass="section-title" />
            <TableView fx:id="circuitTable" prefHeight="320.0" />
            <HBox spacing="8">
                <Button text="View Details" onAction="#onViewDetails" />
                <Button text="Refresh" onAction="#onRefresh" />
            </HBox>
            <padding>
                <Insets />
            </padding>
        </VBox>
    </center>
</fx:root>
