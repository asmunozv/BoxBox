<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<fx:root type="javafx.scene.layout.BorderPane" xmlns:fx="http://javafx.com/fxml/1" styleClass="main-view">
  <left><ScrollPane fitToWidth="true" prefWidth="215" minWidth="185" hbarPolicy="NEVER"><content><VBox fx:id="sidebar" prefWidth="205" spacing="8" styleClass="sidebar">
    <Label text="BOXBOX" styleClass="brand"/><Label text="RACING · UNDERSTOOD" styleClass="brand-caption"/>
    <Separator/><Label text="ANÁLISIS" styleClass="nav-section"/>
    <VBox fx:id="analysisNavigation" spacing="5"/>
    <Separator/><Label text="TU PROYECTO" styleClass="nav-section"/>
    <VBox fx:id="legacyNavigation" spacing="5"/>
    <Region VBox.vgrow="ALWAYS"/>
    <Label fx:id="userLabel" wrapText="true" styleClass="muted"/>
    <Label fx:id="seasonLabel" text="MySQL local · boxbox_db" styleClass="connection-badge"/>
    <Button fx:id="logoutButton" text="Cerrar sesión" maxWidth="Infinity"/>
    <padding><Insets top="28" right="14" bottom="20" left="18"/></padding>
  </VBox></content></ScrollPane></left>
  <center><StackPane fx:id="contentHost"/></center>
</fx:root>
