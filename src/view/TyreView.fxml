<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?><?import javafx.scene.layout.*?><?import javafx.scene.chart.*?>
<fx:root type="javafx.scene.layout.BorderPane" xmlns:fx="http://javafx.com/fxml/1">
 <top><VBox spacing="10"><Label text="Neumáticos · la secuencia de la carrera" styleClass="section-title"/><FlowPane hgap="10" vgap="8"><ComboBox fx:id="left" prefWidth="230"/><ComboBox fx:id="right" prefWidth="230"/></FlowPane><VBox fx:id="timelines" spacing="6"/></VBox></top>
 <center><LineChart fx:id="lapChart" title="Tiempos por vuelta observados" createSymbols="true"><xAxis><NumberAxis label="Vuelta" forceZeroInRange="false"/></xAxis><yAxis><NumberAxis label="Segundos" forceZeroInRange="false"/></yAxis></LineChart></center>
 <bottom><Label fx:id="detail" wrapText="true" styleClass="explanation-card"/></bottom>
</fx:root>
