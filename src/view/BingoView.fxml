<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<fx:root type="javafx.scene.layout.BorderPane" xmlns:fx="http://javafx.com/fxml/1">
    <center>
        <StackPane fx:id="confettiLayer">
            <VBox spacing="12">
                <Label text="F1 Prediction Bingo" styleClass="section-title" />
                <Label fx:id="subtitleLabel" text="Add your 9 predictions, check them as they happen, and unlock confetti when all are done." />

                <GridPane fx:id="predictionGrid" hgap="10" vgap="10" />

                <HBox spacing="10">
                    <Button text="Reset Bingo" onAction="#onReset" />
                    <Label fx:id="progressLabel" />
                </HBox>
            </VBox>
        </StackPane>
    </center>
    <padding>
        <Insets top="12" right="12" bottom="12" left="12" />
    </padding>
</fx:root>
