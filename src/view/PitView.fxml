 <top><VBox spacing="10"><Label text="Pits · decisiones y contexto" styleClass="section-title"/><FlowPane hgap="10" vgap="8"><ComboBox fx:id="left" prefWidth="230"/><ComboBox fx:id="right" prefWidth="230"/></FlowPane></VBox></top>
 <center><SplitPane orientation="VERTICAL" dividerPositions="0.65"><TableView fx:id="pitTable"/><BarChart fx:id="pitChart" title="Pasos por pits registrados"><xAxis><CategoryAxis/></xAxis><yAxis><NumberAxis label="Pasos registrados" tickUnit="1"/></yAxis></BarChart></SplitPane></center>
 <bottom><Label fx:id="detail" wrapText="true" styleClass="explanation-card"/></bottom>
